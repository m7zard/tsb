		LayoutOrder = rowOrder,
		Parent = thread,
	})
 
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(fromClient and 1 or 0, 0),
		Position = UDim2.fromScale(fromClient and 1 or 0, 0),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Parent = row,
	}, {
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = fromClient and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left,
			Padding = UDim.new(0, 4),
		}),
		create("UISizeConstraint", {MaxSize = Vector2.new(380, math.huge)}),
