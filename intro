			Thickness = 1,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = bubble,
		})
	end
 
	tween(header, 0.3, {TextTransparency = 0})
	tween(bubble, 0.3, {BackgroundTransparency = 0, TextTransparency = 0})
	if stroke then
		tween(stroke, 0.3, {Transparency = 0})
	end
 
	return row, bubble
end
 
local function showTyping(duration)
	local row, bubble = newBubble("Executor", ".")
	local started = os.clock()
	local frame = 0
	while os.clock() - started < duration and not destroyed do
		frame = frame % 3 + 1
		bubble.Text = string.rep(".", frame)
		task.wait(0.3)
	end
	row:Destroy()
end
 
local function say(sender, text, typingTime)
	if typingTime and typingTime > 0 then
		showTyping(typingTime)
	end
	return newBubble(sender, text)
end
 
local function playMoment()
	local waited = 0
	while not assets.Done and waited < 8 do
		task.wait(0.1)
		waited += 0.1
	end
 
	local image = nil
	if assets.Sound then
		activeSound = create("Sound", {
			SoundId = assets.Sound,
			Volume = Config.SoundVolume,
			Looped = false,
			Parent = game:GetService("SoundService"),
		})
		activeSound:Play()
	end
	if assets.Image then
		image = create("ImageLabel", {
			Name = "Intro",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.55, 0.75),
			BackgroundTransparency = 1,
			Image = assets.Image,
			ScaleType = Enum.ScaleType.Fit,
			ImageTransparency = 1,
			ZIndex = 10,
			Parent = gui,
		})
		tween(image, 0.35, {ImageTransparency = 0})
	end
	tween(chat, 0.35, {GroupTransparency = 0.8})
 
	if activeSound or image then
		task.wait(Config.ShowSeconds)
	else
		task.wait(1.5)
	end
 
	if image then
		tween(image, 0.4, {ImageTransparency = 1})
	end
	if activeSound then
		tween(activeSound, 0.4, {Volume = 0})
	end
	tween(chat, 0.4, {GroupTransparency = 0})
	task.wait(0.45)
	if image then
		image:Destroy()
	end
	if activeSound then
		activeSound:Stop()
		activeSound:Destroy()
		activeSound = nil
	end
end
 
local submitted = Instance.new("BindableEvent")
local inputOpen = false
 
local function submit()
	if not inputOpen then
		return
	end
	local text = string.match(box.Text, "^%s*(.-)%s*$")
	if text == "" then
		return
	end
	inputOpen = false
	box.TextEditable = false
	box:ReleaseFocus()
	submitted:Fire(text)
end
 
connections[#connections + 1] = box.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		submit()
	end
end)
connections[#connections + 1] = send.Activated:Connect(submit)
 
local function askForKey()
	inputBar.Visible = true
	tween(inputBar, 0.3, {GroupTransparency = 0})
	inputOpen = true
	box.TextEditable = true
	box.Text = ""
	box:CaptureFocus()
	return submitted.Event:Wait()
end
 
local function keyIsValid(text)
	for _, key in ipairs(Config.Keys) do
		if Config.CaseSensitive then
			if text == key then
				return true
			end
		elseif string.lower(text) == string.lower(key) then
			return true
		end
	end
	return false
end
 
local function loadHub()
	if isPlaceholder(Config.CoreUrl) then
		return
	end
	local ok, source = pcall(game.HttpGet, game, Config.CoreUrl)
	if not ok or type(source) ~= "string" or #source == 0 then
		return
	end
	local compiled, compileError = loadstring(source)
	if not compiled then
		return
	end
	task.spawn(compiled)
end
 
local function destroyLoader()
	if destroyed then
		return
	end
	destroyed = true
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	if activeSound then
		pcall(function()
			activeSound:Stop()
			activeSound:Destroy()
		end)
		activeSound = nil
	end
	submitted:Destroy()
	gui:Destroy()
	if type(delfile) == "function" then
		for _, fileName in ipairs(tempFiles) do
			pcall(delfile, fileName)
		end
	end
	if getgenv().techinifiedLoaderCleanup == destroyLoader then
		getgenv().techinifiedLoaderCleanup = nil
	end
end
 
getgenv().techinifiedLoaderCleanup = destroyLoader
 
local function selfDestruct()
	if type(getgenv().techHubShutdown) == "function" then
		pcall(getgenv().techHubShutdown)
	end
	tween(chat, 0.6, {GroupTransparency = 1})
	task.wait(0.7)
	destroyLoader()
end
 
local function enterHub()
	tween(chat, 0.5, {GroupTransparency = 1})
	task.wait(0.55)
	loadHub()
	tween(black, 0.6, {BackgroundTransparency = 1})
	task.wait(0.65)
	destroyLoader()
end
 
local function run()
	task.wait(0.6)
	say("Client", "Execute the Techinified Hub.")
	task.wait(1)
	say("Executor", "no.", 0.9)
  task.wait(1.5)
	playMoment()
	say("Executor", "jk, where is your key?", 1)
	task.wait(0.3)
 
	local entered = askForKey()
	if destroyed then
		return
	end
	local shown = entered
	if Config.MaskKey then
		shown = string.rep("•", #entered)
	end
	say("Client", shown)
 
	if keyIsValid(entered) then
		task.wait(0.4)
		enterHub()
	else
		say("Executor", "Wrong key, get out.", 0.8)
		task.wait(1.8)
		selfDestruct()
	end
end