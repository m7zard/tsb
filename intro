		Font = Enum.Font.GothamMedium,
		TextTransparency = 1,
		Parent = holder,
	})
 
	local bubble = create("TextLabel", {
		LayoutOrder = 2,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = fromClient and Color3.fromRGB(228, 228, 232) or Color3.fromRGB(26, 26, 31),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = fromClient and Color3.fromRGB(12, 12, 14) or Color3.fromRGB(240, 240, 244),
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
