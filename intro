local function viewSize()
	local size = gui.AbsoluteSize
	if size.X < 2 or size.Y < 2 then
		local camera = workspace.CurrentCamera
		if camera then
			return camera.ViewportSize
		end
		return Vector2.new(1280, 720)
	end
	return size
end

local function updateLayout()
	local view = viewSize()
	local spec = Layout.Garage
	local width = math.max(view.X, view.Y * spec.Aspect)
	local height = width / spec.Aspect
	garage.Size = UDim2.fromOffset(width, height)
	local iconX = view.X / 2 + (spec.IconX - 0.5) * width
	local iconY = view.Y - (1 - spec.IconY) * height
	Layout.Portal.X = iconX / view.X
	Layout.Portal.Y = iconY / view.Y - Layout.Portal.Raise
	portalHolder.Position = UDim2.fromScale(Layout.Portal.X, Layout.Portal.Y)
end

