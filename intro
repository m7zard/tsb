local function walkBob(sprite, seconds)
	local started = os.clock()
	while os.clock() - started < seconds and not destroyed do
		local t = os.clock() - started
		sprite.Position = UDim2.new(0.5, 0, 0.5, -math.abs(math.sin(t * 9)) * 7)
		task.wait()
	end
	if not destroyed then
		sprite.Position = UDim2.fromScale(0.5, 0.5)
	end
end

