local function say(who, text, typingTime)
	for other in pairs(bubbles) do
		if other ~= who then
			removeBubble(other)
		end
	end
	if typingTime and typingTime > 0 then
		local _, label = newBubble(who, ".")
		local started = os.clock()
		local frame = 0
		while os.clock() - started < typingTime and not destroyed do
			frame = frame % 3 + 1
			label.Text = string.rep(".", frame)
			task.wait(0.3)
		end
		removeBubble(who, true)
	end
	if destroyed then
		return
	end
	return newBubble(who, text)
end

