local function fetchAsset(url, fileName)
	if isPlaceholder(url) or type(writefile) ~= "function" or type(getcustomasset) ~= "function" then
		return nil
	end
	local ok, data = pcall(game.HttpGet, game, url)
	if not ok or type(data) ~= "string" or #data == 0 then
		return nil
	end
	if not pcall(writefile, fileName, data) then
		return nil
	end
	tempFiles[#tempFiles + 1] = fileName
	local gotAsset, asset = pcall(getcustomasset, fileName)
	if gotAsset then
		return asset
	end
	return nil
end
 
