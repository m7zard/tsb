local function removeBubble(who, instant)
	local group = bubbles[who]
	if not group then
		return
	end
	bubbles[who] = nil
	if instant then
		group:Destroy()
		return
	end
	tween(group, 0.2, {GroupTransparency = 1})
	task.delay(0.25, function()
		group:Destroy()
	end)
end

local function clearBubbles()
	for who in pairs(bubbles) do
		removeBubble(who)
	end
end

