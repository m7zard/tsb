	end
	say("C137", shown)
	task.wait(0.9)

	if keyIsValid(entered) then
		say("Prime", "Key is correct.", 0.7)
		task.wait(1.4)
		enterHub()
	else
		say("Prime", "Key is not correct.", 0.7)
		task.wait(1.4)
		clearBubbles()
		primeLeaves()
		selfDestruct()
	end
end

