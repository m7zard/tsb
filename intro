local function playMoment()
	local image = nil
	if assets.Sound then
		activeSound = create("Sound", {
			SoundId = assets.Sound,
			Volume = Config.SoundVolume,
			Looped = false,
			Parent = SoundService,
		})
		activeSound:Play()
	end
	if assets.Image then
		image = create("ImageLabel", {
			Name = "Intro",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.55, 0.75),
			BackgroundTransparency = 1,
			Image = assets.Image,
			ScaleType = Enum.ScaleType.Fit,
			ImageTransparency = 1,
			ZIndex = 10,
			Parent = gui,
		})
		tween(image, 0.35, {ImageTransparency = 0})
	end
	tween(scene, 0.35, {GroupTransparency = 0.8})

	if activeSound or image then
		task.wait(Config.ShowSeconds)
	else
		task.wait(1.5)
	end

	if image then
		tween(image, 0.4, {ImageTransparency = 1})
	end
	if activeSound then
		tween(activeSound, 0.4, {Volume = 0})
	end
	tween(scene, 0.4, {GroupTransparency = 0})
	task.wait(0.45)
	if image then
		image:Destroy()
	end
	if activeSound then
		activeSound:Stop()
		activeSound:Destroy()
		activeSound = nil
	end
end

