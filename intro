local function fetchAsset(url, fileName)
	if isPlaceholder(url) then
		log("no link for", fileName)
		return nil
	end
	if type(writefile) ~= "function" or type(getcustomasset) ~= "function" then
		log("executor is not supporting writefile/getcustomasset")
		return nil
	end
	local ok, data = pcall(game.HttpGet, game, url)
	if not ok or type(data) ~= "string" or #data == 0 then
		log("cant load", url, ok and "" or tostring(data))
		return nil
	end
	if data:sub(1, 3) == "404" then
		log("404 â file not found", url)
		return nil
	end
	if not pcall(writefile, fileName, data) then
		log("writefile not worked for", fileName)
		return nil
	end
	tempFiles[#tempFiles + 1] = fileName
	local gotAsset, asset = pcall(getcustomasset, fileName)
	if gotAsset and asset then
		return asset
	end
	log("getcustomasset not worked for", fileName)
	return nil
end

local function queueAsset(key, url, fileName)
	assets.Pending += 1
	task.spawn(function()
		assets[key] = fetchAsset(url, fileName)
		assets.Pending -= 1
		if assetsApplied and applyAssets and not destroyed then
			applyAssets()
		end
	end)
end

