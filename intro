local submitted = Instance.new("BindableEvent")
local inputOpen = false

local function submit()
	if not inputOpen then
		return
	end
	local text = string.match(box.Text, "^%s*(.-)%s*$")
	if text == "" then
		return
	end
	inputOpen = false
	box.TextEditable = false
	box:ReleaseFocus()
	inputGroup.Visible = false
	inputGroup.GroupTransparency = 1
	submitted:Fire(text)
end

connections[#connections + 1] = box.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		submit()
	end
end)
connections[#connections + 1] = send.Activated:Connect(submit)

local function askForKey()
	inputGroup.Visible = true
	tween(inputGroup, 0.3, {GroupTransparency = 0})
	inputOpen = true
	box.TextEditable = true
	box.Text = ""
	box:CaptureFocus()
	return submitted.Event:Wait()
end

local function keyIsValid(text)
	for _, key in ipairs(Config.Keys) do
		if Config.CaseSensitive then
			if text == key then
				return true
			end
		elseif string.lower(text) == string.lower(key) then
			return true
		end
	end
	return false
end

local function loadHub()
	if isPlaceholder(Config.CoreUrl) then
		return
	end
	local ok, source = pcall(game.HttpGet, game, Config.CoreUrl)
	if not ok or type(source) ~= "string" or #source == 0 then
		log("couldn't download hub", Config.CoreUrl)
		return
	end
	local compiled, err = loadstring(source)
	if not compiled then
		log("error compilation hub:", err)
		return
	end
	task.spawn(function()
		local ran, runErr = pcall(compiled)
		if not ran then
			log("error inside hub:", runErr)
		end
	end)
end

local function destroyLoader()
	if destroyed then
		return
	end
	destroyed = true
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	if portalPulse then
		portalPulse:Cancel()
		portalPulse = nil
	end
	if activeSound then
		pcall(function()
			activeSound:Stop()
			activeSound:Destroy()
		end)
		activeSound = nil
	end
	if inputOpen then
		inputOpen = false
		submitted:Fire(nil)
	end
	submitted:Destroy()
	gui:Destroy()
	if type(delfile) == "function" then
		for _, fileName in ipairs(tempFiles) do
			pcall(delfile, fileName)
		end
	end
	if getgenv().techinifiedLoaderCleanup == destroyLoader then
		getgenv().techinifiedLoaderCleanup = nil
	end
end

getgenv().techinifiedLoaderCleanup = destroyLoader

